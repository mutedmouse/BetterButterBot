# ButterBot voice gateway - NVIDIA GPU image (linux/amd64; CUDA 12 + cuDNN 9, as CTranslate2 4.x needs).
#   Prebuilt:  docker pull ghcr.io/<owner>/bb-voice-gateway:gpu        (see docker/README.md)
#   From here: docker compose --profile gpu up -d --build
# Needs the NVIDIA driver on the host and the NVIDIA Container Toolkit (Linux) or Docker Desktop
# with WSL2 GPU support (Windows).
FROM nvidia/cuda:12.6.3-cudnn-runtime-ubuntu24.04

ARG VERSION=dev
LABEL org.opencontainers.image.title="bb-voice-gateway" \
      org.opencontainers.image.description="BetterButterBot voice gateway (NVIDIA GPU): Whisper speech-to-text, command matching, LLM answers, calendar" \
      org.opencontainers.image.version="$VERSION" \
      org.opencontainers.image.licenses="MIT"

ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 DEBIAN_FRONTEND=noninteractive \
    HF_HOME=/data/hf BB_DATA_DIR=/data
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-venv \
    && rm -rf /var/lib/apt/lists/* \
    && python3 -m venv /venv
ENV PATH=/venv/bin:$PATH
WORKDIR /app

COPY requirements.txt .
RUN pip install -r requirements.txt

COPY *.py Scenarios.h config.example.yaml VERSION ./

EXPOSE 8765 8766
VOLUME ["/data"]
HEALTHCHECK --interval=30s --timeout=5s --start-period=10m --retries=3 \
    CMD python -c "import socket; socket.create_connection(('127.0.0.1', 8765), 3)" || exit 1
CMD ["python", "gateway.py", "--config", "/app/config.yaml"]
