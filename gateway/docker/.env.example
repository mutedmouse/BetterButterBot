# Copy to .env next to docker-compose.yml.

# Which gateway to run: cpu (any machine) or gpu (NVIDIA). Every `docker compose` command uses it,
# so plain `docker compose up -d`, `logs -f`, `restart`, `pull` and `down` just work.
COMPOSE_PROFILES=cpu

# Where the image comes from:
#   GitHub Container Registry:  ghcr.io/<github-owner>/bb-voice-gateway
#   Offline file (docker load): bb-voice-gateway
BB_IMAGE=bb-voice-gateway

# Tags: "cpu"/"gpu" follow the newest release; pin a version with e.g. 1.0.1-cpu / 1.0.1-gpu.
BB_CPU_TAG=cpu
BB_GPU_TAG=gpu
